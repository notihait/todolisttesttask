<main class="container">
  <h1>Список задач</h1>

  <%= form_with model: @task, url: tasks_path, class: "task-form" do |f| %>
    <%= f.text_field :title, placeholder: "Что нужно сделать?", autofocus: true, maxlength: 200, autocomplete: "off" %>
    <%= f.submit "Добавить" %>
  <% end %>

  <% if @task.errors.any? %>
    <p class="error"><%= @task.errors.full_messages.to_sentence %></p>
  <% end %>

  <% if @tasks.any? %>
    <ul class="tasks">
      <% @tasks.each do |task| %>
        <li class="task <%= 'done' if task.completed %>">
          <%= button_to task_path(task), method: :patch, class: "check", form_class: "inline", title: "Отметить" do %>
            <%= task.completed ? "✓" : "" %>
          <% end %>

          <span class="title"><%= task.title %></span>

          <%= button_to "✕", task_path(task), method: :delete, class: "delete", form_class: "inline", title: "Удалить" %>
        </li>
      <% end %>
    </ul>

    <p class="counter">
      Выполнено: <%= @tasks.count(&:completed) %> из <%= @tasks.size %>
    </p>
  <% else %>
    <p class="empty">Задач пока нет. Добавьте первую!</p>
  <% end %>
</main>